.env
.git
node_modules
vendor
# Output di Vite (e hot file): l'immagine li rigenera nello stage node-builder.
# Tailwind 4 scansiona in automatico tutto ciò che trova partendo da /app: se
# public/build locale entrasse nel contesto, le classi dei vecchi build
# resterebbero nel CSS per sempre.
public/build
public/hot
# File caricati/scaricati (immagini delle carte, ecc.): in dev e in prod
# ./storage è montato come volume su /var/www/html/storage, quindi copiarli
# nell'immagine occuperebbe solo spazio inutilmente (il volume li nasconde).
storage/app/public/*
